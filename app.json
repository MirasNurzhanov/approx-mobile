{
  "expo": {
    "name": "aura-mobile",
    "slug": "aura-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "auramobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyB6YKoTOr3yNCMLyzeHBZmqspts7p-2zHw"
      },
      "bundleIdentifier": "com.arcanix.aura",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location",
          "audio",
          "fetch",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "Aura uses your location to find nearby people with shared interests.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Aura uses your location in the background to notify you when you enter someone's zone.",
        "NSLocationAlwaysUsageDescription": "Aura uses your location in the background to notify you when you enter someone's zone."
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB6YKoTOr3yNCMLyzeHBZmqspts7p-2zHw"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.arcanix.aura"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aura uses your location to find nearby people and detect zones.",
          "locationAlwaysPermission": "Aura uses your location in the background for zone detection.",
          "locationWhenInUsePermission": "Aura uses your location to find nearby people.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Aura uses your camera so you can take photos for stories and messages.",
          "photosPermission": "Aura accesses your photos so you can share them in stories and messages."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a07cd98a-5015-4f63-a367-4526c5a6a222"
      }
    }
  }
}
